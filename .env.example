GEMINI_API_KEY=

# HoopStat Postgres on the VPS (127.0.0.1:5432). For local `npm run dev`,
# tunnel first: ssh -N -L 15432:127.0.0.1:5432 vm44
# then point this at the tunneled port.
DATABASE_URL=postgresql://hoopstat:CHANGE_ME@127.0.0.1:15432/hoopstat

# Go API listen address (npm run dev proxies Vite :3000 → this).
# On VPS use 127.0.0.1:8088 so we do not collide with Dokploy :3000.
API_ADDR=:8080
# STATIC_DIR=/opt/hoopstat/app/dist

# Cookie signing. Required when HOOPSTAT_ENV=production.
SESSION_SECRET=

# Practice video uploads (disk fallback). Prefer Google Drive OAuth when linked.
UPLOAD_DIR=data/uploads
GOOGLE_OAUTH_CLIENT=secrets/oauth_web.json
GOOGLE_OAUTH_TOKEN=secrets/drive_token.json
GOOGLE_OAUTH_REDIRECT=https://hoopstats.kognifx.com/api/drive/callback
GOOGLE_DRIVE_FOLDER_ID=1Hy62WZPABG1cP0lPu_5OJZwUdBBnQ_CV

# production = refuse missing SESSION_SECRET
# HOOPSTAT_ENV=production
