GEMINI_API_KEY=

# HoopStat Postgres on the VPS (127.0.0.1:5432). For local `npm run dev`,
# tunnel first: ssh -N -L 15432:127.0.0.1:5432 vm44
# then point this at the tunneled port.
DATABASE_URL=postgresql://hoopstat:CHANGE_ME@127.0.0.1:15432/hoopstat

# Go API listen address (npm run dev proxies Vite :3000 → this)
API_ADDR=:8080

# Cookie signing. Required when HOOPSTAT_ENV=production.
SESSION_SECRET=

# production = refuse missing SESSION_SECRET
# HOOPSTAT_ENV=production
