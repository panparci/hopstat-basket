GEMINI_API_KEY=

# SumoPod OpenAI-compatible (preferred for /api/gemini/generate when set).
# Never commit real keys. Model/base URL hanya dari env (SUMOPOD_* / GEMINI_MODEL).
SUMOPOD_API_KEY=
SUMOPOD_BASE_URL=
SUMOPOD_MODEL=
# GEMINI_MODEL=

# HoopStat Postgres on the VPS (127.0.0.1:5432). For local `npm run dev`,
# tunnel first: ssh -N -L 15432:127.0.0.1:5432 vm44
# then point this at the tunneled port.
DATABASE_URL=postgresql://hoopstat:CHANGE_ME@127.0.0.1:15432/hoopstat

# Go API listen address (npm run dev proxies Vite :3000 → this).
# On VPS use 127.0.0.1:8088 so we do not collide with Dokploy :3000.
API_ADDR=:8080
# STATIC_DIR=/opt/hoopstat/app/dist

# Cookie signing. Required when HOOPSTAT_ENV=production.
SESSION_SECRET=

# Practice photo uploads (disk). Videos go to Bunny Stream.
UPLOAD_DIR=data/uploads

# Bunny Stream (practice video uploads). Never commit real keys.
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_CDN_HOST=

# Google sign-in only (Drive uploads removed).
GOOGLE_OAUTH_CLIENT=secrets/oauth_web.json
GOOGLE_LOGIN_REDIRECT=https://hoopstats.kognifx.com/api/auth/google/callback

# production = refuse missing SESSION_SECRET
# HOOPSTAT_ENV=production
