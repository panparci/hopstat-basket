[Unit]
Description=HoopStat
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/hoopstat/app
EnvironmentFile=/opt/hoopstat/.env
Environment=HOOPSTAT_ENV=production
Environment=STATIC_DIR=/opt/hoopstat/app/dist
ExecStart=/opt/hoopstat/bin/hoopstat
Restart=on-failure
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
